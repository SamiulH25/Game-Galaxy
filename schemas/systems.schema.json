{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"systems": {
			"maxItems": 64,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
					},
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 40
					},
					"description": {
						"type": "string",
						"maxLength": 400
					},
					"star": {
						"type": "object",
						"properties": {
							"color": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"size": {
								"type": "number",
								"minimum": 0.5,
								"maximum": 2
							}
						},
						"required": [
							"color"
						],
						"additionalProperties": false
					},
					"position": {
						"type": "array",
						"prefixItems": [
							{
								"type": "number"
							},
							{
								"type": "number"
							}
						]
					}
				},
				"required": [
					"id",
					"name",
					"star"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"systems"
	],
	"additionalProperties": false,
	"title": "Game Galaxy star systems (systems.json)"
}
