# Game Galaxy 2.0 — copy to backend/.env and adjust for your server
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# SQLite (default). For Postgres later: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./game_galaxy.db

# Auto-generated on first setup (npm run setup) if still default
SECRET_KEY=change-me-in-production

# Bind address — use 0.0.0.0 to accept LAN/internet; 127.0.0.1 for local only
HOST=0.0.0.0
PORT=4321

# Path to games folder (relative to backend/ or absolute)
GAMES_DIR=../games

# Set true for dev-only game cache busting
DEBUG=false

# Auto-rescan when games/*/manifest.json changes (recommended on server dev hosts)
GAMES_WATCH=true

# No-cache /games assets so iframe refresh picks up JS/CSS edits without hard refresh
GAMES_LIVE_RELOAD=true

# Optional: token for `npm run games:rescan` when DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
# GAMES_RESCAN_TOKEN=

# Optional: extra CORS origins (comma-separated), e.g. https://games.example.com
# CORS_ORIGINS=
