; Engine configuration file.
; Game Galaxy 2.0 — Godot Game Template
; Copy this folder to create a new game.

[application]

config/name="Galaxy Game"
config/description="A Game Galaxy 2.0 game built with Godot."
run/main_scene="res://example/ExampleGame.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/always_on_top=false
window/dpi/allow_hidpi=true

[input]

; Default input map — customize per game

[autoload]

GalaxyAPI="*res://GalaxyAPI.gd"

[export]

; Web export preset (set path when exporting)
; html/custom_html_shell should point to res://galaxy_template.html
