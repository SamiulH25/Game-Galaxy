{
  "name": "game-galaxy",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A 3D galaxy of playable browser games with accounts, cloud saves, leaderboards and achievements.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "new-game": "node scripts/new-game.mjs",
    "schemas": "vitest run tests/schemas.test.ts -u"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.4",
    "three": "0.187.0",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "drizzle-kit": "0.31.11",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
