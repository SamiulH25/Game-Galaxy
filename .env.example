# Docker Compose — copy to .env in repo root (optional)
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=change-me-in-production
PORT=4321

# Docker: live games from ./games on the host (see docs/SERVER-DEV.md)
GAMES_WATCH=true
GAMES_LIVE_RELOAD=true
