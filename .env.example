# Copy to .env and adjust. All values are optional in development.

# Where the SQLite database lives (created automatically).
DATABASE_PATH=./data/galaxy.db

# Folder that holds game folders (each with a game.json) and systems.json.
GAMES_DIR=./games

# How often (seconds) the catalog re-checks GAMES_DIR for added/changed games.
GAMES_RESCAN_SECONDS=10

# Production only (adapter-node): the public URL of the site, e.g. https://galaxy.example.com
# ORIGIN=http://localhost:3000
# PORT=3000
